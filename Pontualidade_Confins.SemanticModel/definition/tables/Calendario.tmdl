	partition Calendario = calculated
		mode: import
		source = ```
				
				ADDCOLUMNS (
				    CALENDAR ( DATE ( 2026, 1, 1 ), DATE ( 2026, 8, 31 ) ),
				    "Ano", YEAR ( [Date] ),
				    "MesNum", MONTH ( [Date] ),
				    "Mes", FORMAT ( [Date], "mmm", "pt-BR" ),
				    "AnoMes", FORMAT ( [Date], "yyyy-mm" )
				)
				
				```

