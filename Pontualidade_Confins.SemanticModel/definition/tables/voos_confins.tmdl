	column 'Faixa Ordem' =
			
			SWITCH (
			    TRUE (),
			    voos_confins[Hora_Prevista] < 6, 1,
			    voos_confins[Hora_Prevista] < 12, 2,
			    voos_confins[Hora_Prevista] < 18, 3,
			    4
			)
		formatString: 0
		lineageTag: 55314675-4ff0-45eb-912c-3294397ed60d
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	partition voos_confins = m
		mode: import
		source =
				let
				    Fonte = Csv.Document(File.Contents("D:\Meu projeto\dados_tratados\voos_confins.csv"),[Delimiter=";", Columns=30, Encoding=65001, QuoteStyle=QuoteStyle.None]),
