table voos_confins
	lineageTag: 2e6fc66b-6bcf-4035-84e1-cd51ca465112

	measure 'Total Voos' = COUNTROWS(voos_confins)
		formatString: 0
		lineageTag: 5bd2da7f-6820-475c-91a4-14a4b05176a4

	measure 'Voos Medidos' = CALCULATE([Total Voos], voos_confins[Cancelado] = FALSE(), voos_confins[Sem_Horario_Previsto] = FALSE())
		formatString: 0
		lineageTag: 06dbc3bb-29f7-4ae2-b925-8a0daeedd146

	measure '% Pontualidade' = DIVIDE(CALCULATE([Total Voos], voos_confins[Pontual] = TRUE()), [Voos Medidos])
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 6c2501a0-b24f-46b8-a3fe-cf4957b4ce98

	measure '% Cancelamento' = DIVIDE(CALCULATE([Total Voos], voos_confins[Cancelado] = TRUE()), [Total Voos])
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: d38bc159-da25-4fb9-acef-f0dac64aef46

	measure 'Voos Cancelados' = CALCULATE ( [Total Voos], voos_confins[Cancelado] = TRUE () )
		formatString: 0
		lineageTag: 20f3c0e0-7130-478b-bd6d-5b3e8b3f3f27

	measure 'Voos Pontuais' = CALCULATE ( [Total Voos], voos_confins[Pontual] = TRUE () )
		formatString: 0
		lineageTag: ff56f1fa-b798-4a45-9729-9505929775ae

	measure 'Voos Pontuais 15min' = CALCULATE ( [Total Voos], voos_confins[Pontual_15min] = TRUE () )
		formatString: 0
		lineageTag: c6579ac9-d87c-4d12-abc4-76a929555a1b

	measure '% Pontualidade 15min' = DIVIDE ( [Voos Pontuais 15min], [Voos Medidos] )
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 1016aecb-c834-4d68-9269-14f6c74400eb

	measure 'Atraso Medio (min)' = CALCULATE ( AVERAGE ( voos_confins[Atraso_Min] ), voos_confins[Cancelado] = FALSE (), voos_confins[Sem_Horario_Previsto] = FALSE () )
		formatString: 0.0
		lineageTag: cfa885ba-ada4-47c8-94dc-fba0050f588a

	measure 'Total Voos (cartao)' = FORMAT ( [Total Voos], "#,0", "pt-BR" )
		lineageTag: c22fb48a-93bc-4e7b-91d8-365fda886152

	measure 'Voos Medidos (cartao)' = FORMAT ( [Voos Medidos], "#,0", "pt-BR" )
		lineageTag: 76e54032-9873-46e3-b4ae-01389d96d0a5

	measure 'Voos Cancelados (cartao)' = FORMAT ( [Voos Cancelados], "#,0", "pt-BR" )
		lineageTag: 6ca4847a-028a-4d64-972f-9c82a0db9186

	measure 'Voos Pontuais (cartao)' = FORMAT ( [Voos Pontuais], "#,0", "pt-BR" )
		lineageTag: ea7bc8dc-f688-455e-873b-130e3b3b34c7

	measure '% Pontualidade Mes Anterior' = CALCULATE([% Pontualidade], DATEADD(Calendario[Date], -1, MONTH))
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 103a9a14-d641-42ca-ab6b-bc98b3fac688

	measure 'Variacao Pontualidade (p.p.)' =
			VAR atual = [% Pontualidade]
			VAR anterior = [% Pontualidade Mes Anterior]
			RETURN IF(ISBLANK(anterior), BLANK(), (atual - anterior) * 100)
		formatString: +0.0;-0.0;0.0
		lineageTag: 79a22bb6-338c-4aed-a3bc-68a525f02e10

	measure '% Cancelamento Mes Anterior' = CALCULATE([% Cancelamento], DATEADD(Calendario[Date], -1, MONTH))
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: a9936412-b7a5-4e5a-b136-f1928945b3ab

	measure 'Pontualidade Geral (todas as cias)' = CALCULATE([% Pontualidade], ALL(voos_confins[Companhia]))
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: cc8d722b-f312-43af-8619-499d7c71dff2

	measure 'Diferenca vs Geral (p.p.)' = ([% Pontualidade] - [Pontualidade Geral (todas as cias)]) * 100
		formatString: +0.0;-0.0;0.0
		lineageTag: 5c232edd-9837-489c-bae2-b1df4b248332

	measure 'Amostra Suficiente' = IF([Voos Medidos] >= 150, 1, 0)
		formatString: 0
		lineageTag: 4729a371-69a5-4095-af8e-435736bedaf1

