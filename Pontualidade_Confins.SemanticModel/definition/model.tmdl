model Model
	culture: pt-BR
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: pt-BR
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

/// Erros nas consultas que foram carregadas em 09/10/2026 07:02:35.
queryGroup 'Erros na Consulta - 09/10/2026 07:02:35'

	annotation PBI_QueryGroupOrder = 0

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["voos_confins","Erros em voos_confins"]

annotation PBI_ProTooling = ["MCP-PBIModeling","DevMode"]

ref table voos_confins
ref table Calendario

ref cultureInfo pt-BR

